# Local application
DATABASE_URL=postgresql://zuegelofferte:zuegelofferte@localhost:5433/zuegelofferte
PAYLOAD_SECRET=replace-with-a-long-random-value
BETTER_AUTH_SECRET=replace-with-a-long-random-value
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Google Maps (optional; manual route fallback remains available)
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Vercel AI Gateway / Gemini inventory analysis (optional)
AI_GATEWAY_API_KEY=
AI_INVENTORY_MODEL_ID=google/gemini-3.7-flash

# Explicitly enable the unauthenticated company portal only for a POC preview
POC_DEMO_MODE=false

# Optional email and observability configuration
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
