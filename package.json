{
  "name": "zuegelofferte",
  "version": "1.0.0",
  "description": "White-label offer calculator for Swiss moving companies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimpleDay/move-calculator.git"
  },
  "scripts": {
    "prepare": "husky",
    "ci": "turbo run generate:migration check:types test",
    "lint:commit": "commitlint",
    "lint": "eslint --fix .",
    "format": "prettier --write --ignore-unknown --log-level warn . && node scripts/minifyMigrations.mjs",
    "web": "pnpm --filter @zuegelofferte/web",
    "dev": "turbo watch dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "check:types": "turbo run check:types",
    "check:submodules": "node scripts/checkSubmoduleVersions.mjs",
    "generate": "turbo run generate"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@eslint/js": "^9.37.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/eslint-config-prettier": "^6.11.3",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "**/*": [
      "prettier --write --ignore-unknown",
      "eslint --fix"
    ],
    "**/migrations/*.json": "node scripts/minifyMigrations.mjs"
  },
  "private": true,
  "author": "hosting@devedis.ch",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
